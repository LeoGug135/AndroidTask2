<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#FFFFFF">

    <!-- ==================== 顶部灰色导航条 ==================== -->
    <View
        android:id="@+id/topBarBg"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:background="#F0F0F0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 导航项 1：Space Stations -->
    <ImageView
        android:id="@+id/ivStation"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/space_station_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ivFlights"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <TextView
        android:id="@+id/tvStation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Space Stations"
        android:textSize="12sp"
        android:textColor="#555555"
        app:layout_constraintTop_toBottomOf="@id/ivStation"
        app:layout_constraintStart_toStartOf="@id/ivStation"
        app:layout_constraintEnd_toEndOf="@id/ivStation" />

    <!-- 导航项 2：Flights -->
    <ImageView
        android:id="@+id/ivFlights"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/rocket_icon"
        app:layout_constraintStart_toEndOf="@id/ivStation"
        app:layout_constraintEnd_toStartOf="@id/ivRover"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvFlights"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Flights"
        android:textSize="12sp"
        android:textColor="#555555"
        app:layout_constraintTop_toBottomOf="@id/ivFlights"
        app:layout_constraintStart_toStartOf="@id/ivFlights"
        app:layout_constraintEnd_toEndOf="@id/ivFlights" />

    <!-- 导航项 3：Rovers -->
    <ImageView
        android:id="@+id/ivRover"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/rover_icon"
        app:layout_constraintStart_toEndOf="@id/ivFlights"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvRover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Rovers"
        android:textSize="12sp"
        android:textColor="#555555"
        app:layout_constraintTop_toBottomOf="@id/ivRover"
        app:layout_constraintStart_toStartOf="@id/ivRover"
        app:layout_constraintEnd_toEndOf="@id/ivRover" />

    <!-- ==================== 中间 DCA -> MARS 区域 ==================== -->

    <!-- DCA 绿色方块（左） -->
    <TextView
        android:id="@+id/tvDca"
        android:layout_width="130dp"
        android:layout_height="100dp"
        android:background="#2E7D32"
        android:text="DCA"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:layout_marginStart="60dp"
        app:layout_constraintTop_toBottomOf="@id/tvStation"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- MARS 绿色方块（右），与 DCA 严格上下对齐 -->
    <TextView
        android:id="@+id/tvMars"
        android:layout_width="130dp"
        android:layout_height="100dp"
        android:background="#2E7D32"
        android:text="MARS"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginEnd="60dp"
        app:layout_constraintTop_toTopOf="@id/tvDca"
        app:layout_constraintBottom_toBottomOf="@id/tvDca"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 双向箭头：左右约束到两个方块外侧，实现居中覆盖；elevation 保证层级在最上 -->
    <ImageView
        android:id="@+id/ivArrows"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/double_arrows"
        android:background="#FFFFFF"
        android:padding="10dp"
        android:elevation="4dp"
        app:layout_constraintStart_toStartOf="@id/tvDca"
        app:layout_constraintEnd_toEndOf="@id/tvMars"
        app:layout_constraintTop_toTopOf="@id/tvDca"
        app:layout_constraintBottom_toBottomOf="@id/tvDca" />

    <!-- ==================== 左侧橙色选项按钮 ==================== -->
    <TextView
        android:id="@+id/tvOneWay"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:layout_marginTop="30dp"
        android:layout_marginStart="16dp"
        android:background="#F57C00"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="One Way"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvDca"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 白圈开关 -->
    <Switch
        android:id="@+id/switchOneWay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:checked="true"
        android:thumbTint="#FFFFFF"
        android:trackTint="@android:color/transparent"
        app:layout_constraintTop_toTopOf="@id/tvOneWay"
        app:layout_constraintBottom_toBottomOf="@id/tvOneWay"
        app:layout_constraintEnd_toEndOf="@id/tvOneWay" />

    <TextView
        android:id="@+id/tvTraveller"
        android:layout_width="110dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="#F57C00"
        android:gravity="center"
        android:text="1 Traveller"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvOneWay"
        app:layout_constraintStart_toStartOf="@id/tvOneWay" />

    <!-- ==================== 底部中间插图 ==================== -->
    <ImageView
        android:id="@+id/ivGalaxy"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/galaxy"
        app:layout_constraintTop_toBottomOf="@id/tvTraveller"
        app:layout_constraintBottom_toTopOf="@id/btnDepart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.6" />

    <ImageView
        android:id="@+id/ivRocket"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/rocket_icon"
        app:layout_constraintTop_toTopOf="@id/ivGalaxy"
        app:layout_constraintBottom_toBottomOf="@id/ivGalaxy"
        app:layout_constraintEnd_toStartOf="@id/ivGalaxy" />

    <!-- ==================== 底部 DEPART 按钮 ==================== -->
    <Button
        android:id="@+id/btnDepart"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_margin="16dp"
        android:backgroundTint="#2E7D32"
        android:text="DEPART"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>